{
  "name": "devot",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r --parallel exec tsc --noEmit",
    "test": "vitest run --testTimeout=90000",
    "p0": "pnpm --filter @devot/server p0",
    "sim:bench": "pnpm --filter @devot/sim-voxel bench",
    "sim:demo": "pnpm --filter @devot/sim-voxel demo",
    "sim:evolve": "pnpm --filter @devot/sim-voxel evolve",
    "sim:evolve:multi": "pnpm --filter @devot/sim-voxel evolve:multi"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
