# Copie ce fichier en `.env` à la racine, puis renseigne ta clé si tu veux
# de vrais esprits Claude. SANS clé, le jeu tourne quand même : les esprits
# sont simulés (MockMind, 0 dépense).

# Clé API Anthropic pay-per-token (https://platform.claude.com → API keys).
# NB : l'abonnement Claude Code Max ne fonctionne PAS ici — la Messages API
# exige une clé Console (ou un profil `ant auth login`).
ANTHROPIC_API_KEY=sk-ant-...

# Optionnel — forcer les esprits simulés même avec une clé (0 dépense API)
# DEVOT_MOCK=1

# Optionnel — décisions cycliques du mock, pour démo (idle,reproduce,attack,speak)
# DEVOT_MOCK_SCRIPT=idle,reproduce

# Optionnel — port du serveur Colyseus (défaut 2567)
# PORT=2567

# Optionnel — chemin de la base SQLite du monde (défaut : apps/server/world.sqlite)
# DEVOT_DB=./world.sqlite
