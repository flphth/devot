# ── Inférence des devots ─────────────────────────────────────
# "claude" = ton plan Claude Code Max via l'Agent SDK (OAuth)
# "mock"   = esprit déterministe, hors-ligne, 0 quota (dev)
MIND=claude

# Modèle qui anime les devots (frugal recommandé pour préserver le quota Max)
DEVOT_MODEL=claude-haiku-4-5

# IMPORTANT : pour utiliser l'abonnement Max, NE PAS définir de clé API
# pay-per-token — elle prendrait le dessus sur l'abonnement.
# ANTHROPIC_API_KEY=

# Port du serveur Colyseus
PORT=2567

# Auto-crée un dieu + devot fondateur au démarrage (utile en headless/P0)
SEED_FOUNDER=1
