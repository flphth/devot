# Copie ce fichier en `.env` à la racine du projet.

# ── Backend des esprits ──────────────────────────────────────────────
# claude = ton abonnement Claude Code (Agent SDK, OAuth déjà présent sur la
#          machine) — AUCUNE clé API, aucune facturation au token. Défaut.
# api    = Messages API pay-per-token (nécessite ANTHROPIC_API_KEY)
# mock   = esprits simulés, hors-ligne, 0 dépense (dev / démo)
MIND=claude

# Optionnel — forcer le modèle des devots quel que soit leur palier
# (le tarif HP reste celui du palier frugal/équilibré/prophète)
# DEVOT_MODEL=claude-haiku-4-5

# Uniquement si MIND=api : clé Console (https://platform.claude.com → API keys).
# NB : la définir sans MIND explicite bascule automatiquement en mode api.
# ANTHROPIC_API_KEY=sk-ant-...

# Optionnel — décisions cycliques du mock, pour démo (idle,reproduce,attack,speak)
# DEVOT_MOCK_SCRIPT=idle,reproduce

# Optionnel — port du serveur Colyseus (défaut 2567)
# PORT=2567

# Optionnel — chemin de la base SQLite du monde (défaut : apps/server/world.sqlite)
# DEVOT_DB=./world.sqlite

# ── 0G Compute (testnet only) ────────────────────────────────────────
# Disposable key, funded from the 0G testnet faucet. Never real funds.
# Mainnet chainId 16661 / testnet chainId 16602.
ZG_PRIVATE_KEY=
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
# Provider de calcul 0G (chatbot). listService() pour en découvrir d'autres.
ZG_PROVIDER=0xa48f01287233509FD694a22Bf840225062E67836

# ── LifeVault (0G Galileo, chain 16602) ──────────────────────────────
# With these set, a birth becomes a REAL transaction: createDevot(identityHash)
# payable, and the wei deposited becomes that devot's balance — which is its
# life. Leave them out and the world runs without a chain (loudly).
# LIFEVAULT_ADDRESS=0x...
# DEVOT_DEPOSIT_WEI=1000000000000000
