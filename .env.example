# ── Esprit des devots (MindProvider) ─────────────────────────
# "mock"   = esprit déterministe, hors-ligne, 0 quota (dev/tests)
# "api"    = Anthropic pay-per-token (ANTHROPIC_API_KEY requis)
# "claude" = plan Claude Code Max via l'Agent SDK (OAuth) — non câblé en P0
# "0g"     = 0G Compute Network (vraie inférence vérifiable TEE)
MIND=mock

# Modèle qui anime les devots.
#   Anthropic : claude-haiku-4-5 | claude-sonnet-4-6 | claude-opus-4-8
#   0G        : ignoré — le modèle vient de getServiceMetadata du provider
DEVOT_MODEL=claude-haiku-4-5

# Dépôt de vie initial du devot, en µ$ d'inférence (50 000 = 0,05 $).
DEPOSIT_MICRO_USD=50000

# ── MIND=api (Anthropic pay-per-token) ───────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── MIND=0g (0G Compute — TESTNET UNIQUEMENT) ────────────────
# Clé JETABLE d'un wallet testnet approvisionné. JAMAIS une clé qui vaut
# quelque chose, JAMAIS de fonds réels.
# ZG_PRIVATE_KEY=0x...
# ZG_RPC_URL=https://evmrpc-testnet.0g.ai
# ZG_PROVIDER=            # adresse d'un provider précis (sinon: 1er service TEE)
# ZG_RESPONSE_FORMAT=     # "json_object" pour tenter le mode JSON (sinon: schéma+réparation seuls)
# ZG_A0GI_USD=2           # taux A0GI→USD PROVISOIRE (recalibré en G2)

# ── Divers ───────────────────────────────────────────────────
# MAX_CYCLES=6            # nombre de pensées dans le runner mortal-core
# LETHALITY=1             # multiplicateur coût→vie (recalibré en G2)
PORT=2567
SEED_FOUNDER=1
