# Copy this file to `.env` at the root of the project.

# ── Mind backend ─────────────────────────────────────────────────────
# claude = your Claude Code subscription (Agent SDK, OAuth already present on
#          the machine) — NO API key, no per-token billing. The default.
# api    = pay-per-token Messages API (requires ANTHROPIC_API_KEY)
# mock   = simulated minds, offline, zero spend (dev / demo)
MIND=claude

# Optional — force the devots' model whatever their tier
# (the HP price stays that of the frugal/balanced/prophet tier)
# DEVOT_MODEL=claude-haiku-4-5

# Only if MIND=api: Console key (https://platform.claude.com → API keys).
# NB: setting it without an explicit MIND switches automatically to api mode.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional — cyclic mock decisions, for demos (idle,reproduce,attack,speak)
# DEVOT_MOCK_SCRIPT=idle,reproduce

# Optional — Colyseus server port (default 2567)
# PORT=2567

# Optional — path to the world's SQLite database (default: apps/server/world.sqlite)
# DEVOT_DB=./world.sqlite
