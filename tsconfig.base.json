{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@devot/shared": ["packages/shared/src/index.ts"],
      "@devot/shared/*": ["packages/shared/src/*"],
      "@devot/agents": ["packages/agents/src/index.ts"],
      "@devot/agents/*": ["packages/agents/src/*"],
      "@devot/sim": ["packages/sim/src/index.ts"],
      "@devot/sim/*": ["packages/sim/src/*"]
    }
  }
}
